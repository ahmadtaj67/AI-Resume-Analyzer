PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated list for multiple production frontend origins.
CORS_ORIGINS=

SUPABASE_URL=
# Older Supabase projects may call this a service_role key. Keep it server-only.
SUPABASE_SECRET_KEY=
# Supabase anon key is not used by this app because the browser does not connect
# directly to Supabase. If you keep one for reference, never use it as the
# server-side secret.

JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

MAX_RESUME_FILE_SIZE_MB=5
MAX_EXTRACTED_TEXT_CHARACTERS=50000
EXTRACTED_TEXT_PREVIEW_CHARACTERS=3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
MAX_AI_RESUME_TEXT_CHARACTERS=30000
